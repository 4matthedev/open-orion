# ---- Provider selection: auto | ollama | api ----
# auto = try local Ollama first, fall back to the cloud API if reachable.
ORION_PROVIDER=auto

# Local Ollama
ORION_OLLAMA_BASE_URL=http://localhost:11434
# Empty = auto-pick the best model you have installed in Ollama (zero-config).
# Any model the user has pulled works; switch anytime with /model <name>.
ORION_OLLAMA_MODEL=

# Cloud API (used when provider=api, or as auto fallback)
ORION_API_PROVIDER=openai            # openai | anthropic
ORION_API_MODEL=openai/gpt-4o-mini   # or e.g. anthropic/claude-sonnet-4-5
ORION_API_KEY=
ORION_API_BASE_URL=

# ---- Model behaviour ----
ORION_TEMPERATURE=0.1
ORION_LLM_TIMEOUT=120

# ---- Theme (GUI / HUD palette) ----
# Builtin: jarvis, orion, matrix, solarized, nord, amber
# or a path to a custom JSON theme file (any missing keys fall back to "jarvis")
ORION_THEME=

# ---- Safety ----
# strict     = confirm before EVERY command
# confirm    = confirm risky/destructive commands (default)
# permissive = auto-run risky commands (catastrophic hard-blocks still enforced)
# auto       = fully autonomous, no prompts (catastrophic hard-blocks still enforced)
ORION_SAFETY_LEVEL=confirm
ORION_DRY_RUN=false
# Force a confirmation prompt before EVERY command, acting as an override even
# when safety_level is auto/permissive.
ORION_ALWAYS_CONFIRM=false

# ---- Execution limits ----
ORION_MAX_COMMAND_LENGTH=4096
ORION_SHELL_TIMEOUT=120
ORION_MAX_OUTPUT_CHARS=8000

# ---- Conversation context ----
ORION_MAX_HISTORY_TURNS=20
ORION_MAX_CONTEXT_CHARS=12000

# ---- Voice (talk mode) ----
ORION_VOICE_ENABLED=false
ORION_STT_MODEL=small.en
# "default" = auto-detect the liveliest mic; or pin one, e.g.
# alsa_input.usb-...mono-fallback (see `pactl list short sources`).
ORION_STT_DEVICE=default
# Voice-activity-detection floor (absolute RMS threshold): lower for quiet
# mics, raise in noisy rooms. The floor is also derived from measured noise.
ORION_STT_VAD_FLOOR=10
# Prefer an explicit TTS model path (piper .onnx). Empty = auto-discover.
ORION_TTS_MODEL=
# piper = fast CPU fallback (code default); kokoro = Kokoro-82M (most natural);
# xtts = clone a reference voice (needs ORION_TTS_REFERENCE).
ORION_TTS_ENGINE=kokoro
# Kokoro voice name, e.g. am_michael (US male), af_heart (US female), am_onyx (deep), bm_george (UK male)
ORION_TTS_KOKORO_VOICE=am_michael
# <1 = slower speech (1.0 is Kokoro's normal pace)
ORION_TTS_KOKORO_SPEED=0.95
# Override Kokoro model/voices file paths (defaults: ~/.local/share/kokoro/*)
ORION_TTS_KOKORO_MODEL=
ORION_TTS_KOKORO_VOICES=
# Path to a clean .wav/mp3 clip (5-30s) of the voice to clone, e.g. Orion/James Spader
ORION_TTS_REFERENCE=
ORION_TTS_LANGUAGE=en
ORION_TTS_DEVICE=cpu
# >1 = slower speech (1.0 is piper's default)
ORION_TTS_LENGTH_SCALE=1.3
ORION_VOICE_TIMEOUT=12

# ---- Optional working directory for all commands ----
ORION_WORKING_DIR=
